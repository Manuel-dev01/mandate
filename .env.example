# =============================================================================
# Mandate — environment
#
# Values below are LIVE-VERIFIED (13 Sep 2026). See docs/RECON.md.
# Do NOT copy values from the IXS skills repo .env.example — it is stale and
# points at a Base Sepolia vault that no longer exists.
# =============================================================================

# --- SERV Reasoning (REQUIRED) -----------------------------------------------
# Create at https://console.openserv.ai  ->  API keys
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai

# Cheap models for dev/test loops. Reserve a frontier model for the demo only.
SERV_MODEL_DEV=gpt-5.4-mini
SERV_MODEL_DEMO=claude-opus-5

# --- IXS (no API key required) -----------------------------------------------
IXS_API_BASE_URL=https://api-dev-v2.ixs.finance
IXS_MCP_URL=https://api-dev-v2.ixs.finance/mcp

# Read/state target: IXHYB - Avalanche (Fuji testnet, async ERC-7540, no whitelist)
IXS_VAULT_ID=6a952683732c2b84b55ce89b

# Decision target for `npm run act` (IXHYB - BSC). Nothing is executed: IXS vaults are
# not open to outside deposits during the build window (docs/RECON.md §6.10).
IXS_WRITE_VAULT_ID=6a278b40a7d16b245d665479

# The demo portfolio. Every receipt built from it is labelled `declared`, never hidden.
PORTFOLIO_DECLARED_PATH=./packages/agent/portfolio.declared.json

# Receipts (gitignored — they carry wallet addresses).
# RECEIPTS_DIR=./data/receipts
# Last-good vault snapshots: a cold start degrades to these with a STALE badge.
# SNAPSHOT_DIR=./.snapshots
# Per-chat mandates for the Telegram agent.
# MANDATES_DIR=./data/mandates

# --- Telegram (the demo surface) ---------------------------------------------
# Direct bot: create one with @BotFather (/newbot) and paste its token. Long-polls,
# no third party between the treasurer and the handlers. `npm run bot --workspace=agent`.
TELEGRAM_BOT_TOKEN=

# --- Console API (bin/serve.ts) --------------------------------------------
# Railway injects PORT. CONSOLE_API_KEY is optional; the web sends it as x-console-key.
# PORT=8787
# CONSOLE_API_KEY=
# On Railway, point every state dir at the volume:
#   RECEIPTS_DIR=/data/receipts MANDATES_DIR=/data/mandates SNAPSHOT_DIR=/data/snapshots COMPILE_CACHE_DIR=/data/cache

# --- OpenServ platform --------------------------------------------------------
# The agent key from .openserv.json. When set, bin/serve.ts also runs the OpenServ
# agent, which is what fulfils a report bought through their x402 marketplace.
OPENSERV_API_KEY=
# --- OpenServ platform (optional alternative Telegram route) ------------------
# Written by `npm run provision` on first run (SIWE wallet auth). It is NOT the burner
# AGENT_PRIVATE_KEY. Agent credentials live in .openserv.json, also written by provision.
WALLET_PRIVATE_KEY=

# --- DORMANT — the D4 execution path is built but not on the product surface ---------
# Only signer/ and execute/ read these. Not used by the demo, the CLI, or the receipts.
# EXECUTION_MODE=dry-run               # dry-run | live
# FORK_RPC_URL=http://127.0.0.1:8546   # internal test harness (npm run fork), never the demo
# FORK_CHAIN_ID=97

# Other live vaults (source of truth is REST /vaults, not this file):
#   6a278b40a7d16b245d665479  IXHYB - BSC        bsc-testnet   (97)
#   6a8832299e7fddf1f49e6f6c  IXHYB - Arc        arc-testnet   (5042002)
#   6a8ebe8e732c2b84b55ce88c  t_ix7540v1         bsc-testnet   (97)   WHITELIST REQUIRED
#   6a8832289e7fddf1f49e6f51  IXHYB - Robinhood  robinhood-mainnet (4663)  REAL USDG

# --- RPC ---------------------------------------------------------------------
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Wallet (BURNER ONLY) ----------------------------------------------------
# Disposable key; its ADDRESS is what the whitelist check and portfolio reads use.
# Nothing is signed or broadcast on the product surface. Never print, log or commit it.
AGENT_PRIVATE_KEY=


# --- Safety rails ------------------------------------------------------------
# Hard stop on broadcasting to mainnet chain ids. Keep 4663 listed.
BLOCKED_WRITE_CHAIN_IDS=4663,8453,1
# Refuse to build any action above this, regardless of mandate.
MAX_ACTION_ASSET_AMOUNT=10000

# --- Monetization (D9) -------------------------------------------------------
# The audit report is sold over x402. Defaults settle on Base Sepolia through the
# public facilitator: free faucet USDC, no key and no gas on our side (RECON 6.15).
X402_PRICE_USDC=0.50
# X402_PAY_TO=0xEAbc8679638213F952B982dE4e03482B15C77B13   # the identity wallet
# X402_NETWORK=base-sepolia
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e    # USDC on Base Sepolia
# X402_FACILITATOR_URL=https://x402.org/facilitator
# PUBLIC_API_URL=https://<service>.up.railway.app          # so `resource` is the URL actually paid for

# Written by `npm run provision` (the OpenServ paid-service listing) - display only.
# X402_TRIGGER_URL=
# X402_PAYWALL_URL=
# X402_WORKFLOW_ID=

# Written by `npm run identity` (ERC-8004 on Base Sepolia) - display only.
# ERC8004_AGENT_ID=
# ERC8004_TX_HASH=
# ERC8004_CARD_URL=
# ERC8004_SCAN_URL=

# A burner that BUYS a report in rehearsal (`npm run buy`). Never the agent wallet:
# paying yourself is not a sale. Fund it with Base Sepolia USDC at faucet.circle.com.
BUYER_PRIVATE_KEY=

# --- Web console (packages/web/.env.local) -----------------------------------
# MANDATE_API_URL=http://localhost:8787      # or the Railway URL on Vercel
# MANDATE_API_KEY=                           # only if CONSOLE_API_KEY is set on the agent
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/mandaeteBot
