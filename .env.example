# =============================================================================
# Mandate — environment
#
# Values below are LIVE-VERIFIED (13 Sep 2026). See docs/RECON.md.
# Do NOT copy values from the IXS skills repo .env.example — it is stale and
# points at a Base Sepolia vault that no longer exists.
# =============================================================================

# --- SERV Reasoning (REQUIRED) -----------------------------------------------
# Create at https://console.openserv.ai  ->  API keys
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai

# Cheap models for dev/test loops. Reserve a frontier model for the demo only.
SERV_MODEL_DEV=gpt-5.4-mini
SERV_MODEL_DEMO=claude-opus-5

# --- IXS (no API key required) -----------------------------------------------
IXS_API_BASE_URL=https://api-dev-v2.ixs.finance
IXS_MCP_URL=https://api-dev-v2.ixs.finance/mcp

# Primary dev target: IXHYB - Avalanche (Fuji testnet, no whitelist)
IXS_VAULT_ID=6a952683732c2b84b55ce89b

# Other live vaults (source of truth is vaults_list, not this file):
#   6a278b40a7d16b245d665479  IXHYB - BSC        bsc-testnet   (97)
#   6a8832299e7fddf1f49e6f6c  IXHYB - Arc        arc-testnet   (5042002)
#   6a8ebe8e732c2b84b55ce88c  t_ix7540v1         bsc-testnet   (97)   WHITELIST REQUIRED
#   6a8832289e7fddf1f49e6f51  IXHYB - Robinhood  robinhood-mainnet (4663)  REAL USDG

# --- RPC ---------------------------------------------------------------------
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Wallet (BURNER ONLY) ----------------------------------------------------
# Disposable key, testnet funds only, treat as already compromised.
# Writes go to Avalanche Fuji. Robinhood Chain mainnet is READ/PLAN ONLY.
AGENT_PRIVATE_KEY=

# Set by OpenServ provision() on first run — do not create by hand.
WALLET_PRIVATE_KEY=

# --- Safety rails ------------------------------------------------------------
# Hard stop on broadcasting to mainnet chain ids. Keep 4663 listed.
BLOCKED_WRITE_CHAIN_IDS=4663,8453,1
# Refuse to build any action above this, regardless of mandate.
MAX_ACTION_ASSET_AMOUNT=10000

# --- Monetization (D9) -------------------------------------------------------
X402_PRICE_USDC=0.50
# ERC-8004 registration mints on Base MAINNET (8453) and needs real ETH for gas.
ENABLE_ERC8004=false

# --- Web console -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
